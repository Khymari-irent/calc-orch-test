schema_version = 1
status = "proposal"
executable = false
provider = "github"
native_path = ".github/workflows/ci.yml"
validated_against_project = false

[runtime]
name = "unselected"
version = "unselected"
package_manager = "unselected"
lockfile = "unselected"

[commands]
setup = "unselected"
production_policy_precheck = "unselected"
lint = "unselected"
build = "unselected"
test = "unselected"

[pipeline]
order = ["production_policy_precheck_when_main", "lint", "build", "test"]
fail_fast = true
pull_or_merge_request_targets = ["dev", "main"]
manual_dispatch = true
push_trigger = false
schedule_trigger = false
deploy = false
publish = false
coverage_upload = false
production_credentials = false
least_privilege = true

[promotion]
first_buildable_slice = true
remove_proposal_in_same_commit = true
material_change_requires = "APPROVE CI PIPELINE"
